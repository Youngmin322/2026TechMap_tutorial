8%EA%B3%84","kind":"task"}],"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation"}]},{"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/--------------","projects":[{"sections":[{"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#%EC%84%A0%ED%83%9D-%EC%83%81%ED%83%9C%EB%A5%BC-%ED%95%98%EB%82%98%EB%A1%9C-%EB%AA%A8%EC%9C%BC%EA%B8%B0","kind":"task"},{"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#3D-%EA%B2%BD%EA%B3%84-%EC%95%88%EC%97%90-%EC%B9%B4%EB%93%9C%EB%A5%BC-%EC%A0%95%EB%A0%AC%ED%95%98%EA%B8%B0","kind":"task"},{"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#%EC%99%84%EC%84%B1-%ED%9D%90%EB%A6%84-%EB%90%98%EC%A7%9A%EA%B8%B0","kind":"task"}],"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay"}]}],"paths":[["doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas","doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/$volume","doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/--------------"]]},"kind":"project","identifier":{"url":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay","interfaceLanguage":"swift"},"metadata":{"categoryPathComponent":"SolarSystemAtlas","title":"선택한 행성 가까이에 정보를 띄우기","role":"project","category":"SolarSystemAtlas"},"sections":[{"chapter":"행성 정보 인터랙션 만들기","title":"선택한 행성 가까이에 정보를 띄우기","image":"spatial-layout-overlay.svg","content":[{"type":"paragraph","inlineContent":[{"text":"공간 인터페이스에서는 설명 카드를 화면 구석에 고정하는 것보다, 사용자가 고른 대상과 함께 보이게 하는 편이 맥락을 유지하기 쉽습니다. 이 튜토리얼에서는 탭으로 행성을 선택하고, 그 행성의 3D 경계 안에 정보 카드를 배치합니다.","type":"text"}]}],"estimatedTimeInMinutes":25,"backgroundImage":"spatial-layout-overlay.svg","kind":"hero"},{"kind":"tasks","tasks":[{"title":"선택 상태를 하나로 모으기","stepsSection":[{"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"태양계 뷰에 선택 상태를 추가하고 각 행성 뷰에 선택 콜백을 전달합니다. 선택 여부는 ","type":"text"},{"type":"codeVoice","code":"selectedPlanet?.id == planet.id"},{"type":"text","text":"처럼 ID로 비교합니다."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"모델 전체를 다시 만드는 대신 선택된 행성에만 약간의 크기 변화와 오버레이를 적용할 수 있어, 사용자는 무엇을 고른 것인지 즉시 알 수 있습니다."}]}],"code":"s3-complete.swift","runtimePreview":null},{"media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"RealityKit 기반 화면에서는 ","type":"text"},{"type":"codeVoice","code":"InputTargetComponent"},{"type":"text","text":"와 "},{"type":"codeVoice","code":"CollisionComponent"},{"type":"text","text":"를 모델 엔티티에 추가한 뒤, "},{"type":"codeVoice","code":"SpatialTapGesture"},{"type":"text","text":"를 "},{"type":"codeVoice","code":"targetedToAnyEntity()"},{"type":"text","text":"로 연결합니다."}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"이것은 2D 버튼의 사각형 영역이 아니라 3D 모델 자체를 입력 대상으로 만들기 위해 필요합니다. 현재 프로젝트의 "},{"type":"codeVoice","code":"Views\/SolarSystemAtlasView.swift"},{"type":"text","text":"가 이 방식을 사용하므로, Model3D 예제를 RealityView로 확장할 때 참고하세요."}]}],"code":null,"runtimePreview":null}],"contentSection":[{"media":"spatial-layout-overlay.svg","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"선택 상태는 "},{"type":"codeVoice","code":"@State private var selectedPlanet: Planet?"},{"type":"text","text":" 하나로 관리합니다. 행성 모델을 탭하면 그 값을 설정하고, 닫기 버튼이나 같은 행성을 다시 탭하면 "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"로 되돌립니다. 뷰마다 불리언을 따로 두지 않아도 되므로, 선택 가능한 행성이 늘어나도 항상 하나의 카드만 보장됩니다."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI의 "},{"type":"codeVoice","code":"onTapGesture"},{"type":"text","text":"는 시작하기 좋은 입력 방식입니다. 실제 RealityView 기반 앱에서 3D 엔티티를 직접 탭한다면 "},{"type":"codeVoice","code":"SpatialTapGesture().targetedToAnyEntity()"},{"type":"text","text":"로 대체하고, 탭한 엔티티 이름을 "},{"type":"codeVoice","code":"Planet"},{"type":"text","text":"에 매핑하면 같은 상태 흐름을 유지할 수 있습니다."}]}],"kind":"contentAndMedia"}],"anchor":"선택-상태를-하나로-모으기"},{"stepsSection":[{"type":"step","runtimePreview":null,"media":null,"caption":[{"inlineContent":[{"type":"codeVoice","code":"spatialOverlay"},{"type":"text","text":"의 콘텐츠가 여러 개라면 SwiftUI가 내부적으로 공간 컨테이너처럼 정리해 줍니다. 정렬 규칙을 직접 제어해야 할 때는 예제처럼 "},{"type":"codeVoice","code":"SpatialContainer"},{"type":"text","text":"를 명시적으로 사용하면 됩니다."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"전체 장면의 겹침은 "},{"type":"codeVoice","code":"SpatialContainer(alignment: .center)"},{"type":"text","text":"로 감싸고, 선택된 행성 모델에는 "},{"type":"codeVoice","code":".spatialOverlay(alignment: .bottomFront)"},{"type":"text","text":"를 적용합니다."}],"type":"paragraph"}],"code":null},{"runtimePreview":null,"code":"s3-complete.swift","content":[{"inlineContent":[{"type":"codeVoice","code":"PlanetInfoCard"},{"text":"에 이름, 설명, 닫기 버튼을 넣고 ","type":"text"},{"type":"codeVoice","code":".glassBackgroundEffect()"},{"text":"로 읽기 쉬운 표면을 만듭니다. 카드가 나타나고 사라질 때는 ","type":"text"},{"type":"codeVoice","code":"withAnimation"},{"text":"으로 상태 변경을 감싸 전환을 부드럽게 합니다.","type":"text"}],"type":"paragraph"}],"media":null,"caption":[],"type":"step"},{"runtimePreview":null,"code":null,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"선택 → 카드 표시 → 닫기 → 선택 해제 순서로 확인합니다. 행성이 공전 중에도 카드는 선택한 행성과 함께 움직여야 합니다."}]}],"media":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"카드가 너무 가깝거나 멀다면 "},{"type":"codeVoice","code":".bottomFront"},{"type":"text","text":" 대신 "},{"type":"codeVoice","code":".front"},{"type":"text","text":", "},{"type":"codeVoice","code":".trailingFront"},{"type":"text","text":" 같은 "},{"type":"codeVoice","code":"Alignment3D"},{"type":"text","text":" 값을 시험해 보세요. 사용자가 가장 먼저 읽어야 할 정보가 다른 모델을 가리지 않는 위치를 찾는 것이 중요합니다."}]}],"type":"step"}],"contentSection":[{"kind":"contentAndMedia","media":"spatial-layout-overlay.svg","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"code":"SpatialContainer","type":"codeVoice"},{"text":"는 겹쳐진 자식 뷰를 가로·세로·깊이의 세 축으로 정렬하는 레이아웃입니다. 태양계 모델과 보조 UI를 같은 공간에 두고 싶을 때, 2D ","type":"text"},{"code":"ZStack","type":"codeVoice"},{"text":"만으로는 표현하기 어려운 깊이 기준을 제공합니다.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"spatialOverlay(alignment: .bottomFront)","type":"codeVoice"},{"type":"text","text":"는 특정 행성 뷰의 3D 경계 안에 정보 카드를 얹습니다. 여기서 "},{"code":".bottomFront","type":"codeVoice"},{"type":"text","text":"는 카드가 모델의 아래쪽이면서 사용자 쪽에 오도록 지정합니다. 화면 전체의 절대 좌표가 아니라 대상의 경계를 기준으로 하므로, 행성이 움직여도 카드의 의미 있는 위치가 유지됩니다."}]}]}],"title":"3D 경계 안에 카드를 정렬하기","anchor":"3D-경계-안에-카드를-정렬하기"},{"stepsSection":[{"code":null,"type":"step","runtimePreview":null,"media":null,"caption":[],"content":[{"inlineContent":[{"text":"SolarSystemAtlas는 세 단계가 이어진 결과입니다. ","type":"text"},{"type":"codeVoice","code":"depthAlignment"},{"text":"가 행성들이 공유할 깊이 기준면을 만들고 ","type":"text"},{"type":"codeVoice","code":"offset(z:)"},{"text":"가 각 행성의 앞뒤 거리를 정합니다. ","type":"text"},{"type":"codeVoice","code":"rotation3DLayout"},{"type":"text","text":"은 회전한 모델의 프레임까지 레이아웃에 반영해 자전·공전을 자연스럽게 이어 줍니다. 마지막으로 선택 상태와 "},{"type":"codeVoice","code":"SpatialContainer"},{"type":"text","text":"·"},{"type":"codeVoice","code":"spatialOverlay"},{"type":"text","text":"가 대상 가까이에 읽기 쉬운 설명을 배치합니다. 이제 행성 수를 늘리거나, 궤도 링을 RealityKit으로 추가하거나, "},{"type":"codeVoice","code":"ImmersiveSpace"},{"type":"text","text":"에서 더 큰 장면으로 확장해 보세요. 공간 레이아웃의 핵심은 3D 효과를 덧붙이는 것이 아니라 깊이를 처음부터 레이아웃과 상호작용의 일부로 취급하는 데 있습니다."}],"type":"paragraph"}]}],"title":"완성 흐름 되짚기","anchor":"완성-흐름-되짚기","contentSection":[]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/Spatial-Layout-------":{"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/Spatial-Layout-------","title":"Spatial Layout 기초 다지기","url":"\/tutorials\/solarsystematlas\/spatial-layout-------","type":"topic","abstract":[],"role":"article","kind":"article"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas":{"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas","url":"\/tutorials\/solarsystematlas","title":"SwiftUI로 만드는 3D 태양계 도감","type":"topic","abstract":[{"text":"WWDC25 「SwiftUI 공간 레이아웃 만나보기」 세션에서 소개한 Spatial Layout API를 직접 적용해 봅니다.","type":"text"}],"role":"overview","kind":"overview"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/01-SpatialLayoutBasics#%EC%97%AC%EA%B8%B0%EA%B9%8C%EC%A7%80-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"url":"\/tutorials\/solarsystematlas\/01-spatiallayoutbasics#%EC%97%AC%EA%B8%B0%EA%B9%8C%EC%A7%80-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","title":"여기까지 확인하기","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/01-SpatialLayoutBasics#%EC%97%AC%EA%B8%B0%EA%B9%8C%EC%A7%80-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","type":"section","abstract":[{"type":"text","text":"태양계는 행성의 순서만 나열해도 이해할 수 있지만, 모두가 같은 평면에 있으면 궤도와 거리의 감각이 사라집니다. 이 튜토리얼에서는 앱의 구조를 먼저 확인하고, SwiftUI 레이아웃에 깊이 축을 추가하는 방법을 배웁니다."}],"role":"pseudoSymbol","kind":"section"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/01-SpatialLayoutBasics":{"type":"topic","url":"\/tutorials\/solarsystematlas\/01-spatiallayoutbasics","estimatedTime":"20min","title":"깊이 축을 가진 태양계의 첫 장면","abstract":[{"type":"text","text":"태양계는 행성의 순서만 나열해도 이해할 수 있지만, 모두가 같은 평면에 있으면 궤도와 거리의 감각이 사라집니다. 이 튜토리얼에서는 앱의 구조를 먼저 확인하고, SwiftUI 레이아웃에 깊이 축을 추가하는 방법을 배웁니다."}],"kind":"project","role":"project","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/01-SpatialLayoutBasics"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/03-PlanetInfoOverlay":{"role":"project","kind":"project","estimatedTime":"25min","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay","url":"\/tutorials\/solarsystematlas\/03-planetinfooverlay","type":"topic","title":"선택한 행성 가까이에 정보를 띄우기","abstract":[{"text":"공간 인터페이스에서는 설명 카드를 화면 구석에 고정하는 것보다, 사용자가 고른 대상과 함께 보이게 하는 편이 맥락을 유지하기 쉽습니다. 이 튜토리얼에서는 탭으로 행성을 선택하고, 그 행성의 3D 경계 안에 정보 카드를 배치합니다.","type":"text"}]},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/02-PlanetRotation#rotation3DLayout%EC%9C%BC%EB%A1%9C-%ED%9A%8C%EC%A0%84%EC%9D%98-%EC%9E%90%EB%A6%AC%EB%A5%BC-%EA%B3%84%EC%82%B0%ED%95%98%EA%B8%B0":{"abstract":[{"type":"text","text":"앞에서 만든 깊이 있는 태양계에 자전과 공전을 더합니다. 핵심은 회전을 단순한 시각 효과로 끝내지 않고, 회전한 모델의 3D 프레임까지 레이아웃에 반영하는 것입니다."}],"role":"pseudoSymbol","type":"section","url":"\/tutorials\/solarsystematlas\/02-planetrotation#rotation3DLayout%EC%9C%BC%EB%A1%9C-%ED%9A%8C%EC%A0%84%EC%9D%98-%EC%9E%90%EB%A6%AC%EB%A5%BC-%EA%B3%84%EC%82%B0%ED%95%98%EA%B8%B0","kind":"section","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation#rotation3DLayout%EC%9C%BC%EB%A1%9C-%ED%9A%8C%EC%A0%84%EC%9D%98-%EC%9E%90%EB%A6%AC%EB%A5%BC-%EA%B3%84%EC%82%B0%ED%95%98%EA%B8%B0","title":"rotation3DLayout으로 회전의 자리를 계산하기"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/01-SpatialLayoutBasics#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%9D%98-%EC%A7%80%EB%8F%84%EB%A5%BC-%EC%9D%BD%EA%B8%B0":{"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/01-SpatialLayoutBasics#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%9D%98-%EC%A7%80%EB%8F%84%EB%A5%BC-%EC%9D%BD%EA%B8%B0","url":"\/tutorials\/solarsystematlas\/01-spatiallayoutbasics#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%9D%98-%EC%A7%80%EB%8F%84%EB%A5%BC-%EC%9D%BD%EA%B8%B0","title":"프로젝트의 지도를 읽기","type":"section","abstract":[{"type":"text","text":"태양계는 행성의 순서만 나열해도 이해할 수 있지만, 모두가 같은 평면에 있으면 궤도와 거리의 감각이 사라집니다. 이 튜토리얼에서는 앱의 구조를 먼저 확인하고, SwiftUI 레이아웃에 깊이 축을 추가하는 방법을 배웁니다."}],"role":"pseudoSymbol","kind":"section"},"s3-complete.swift":{"identifier":"s3-complete.swift","content":["import SwiftUI","import RealityKit","import RealityKitContent","","struct Planet: Identifiable, Hashable {","    let name: String","    let assetName: String","    let summary: String","    let depth: CGFloat","    let orbitRadius: CGFloat","    let orbitDuration: TimeInterval","    let rotationDuration: TimeInterval","    let rotationDirection: Double","","    var id: String { assetName }","","    static let starter: [Planet] = [","        .init(name: \"수성\", assetName: \"Mercury\", summary: \"태양에 가장 가까운 암석 행성\", depth: -56, orbitRadius: 72, orbitDuration: 12, rotationDuration: 3, rotationDirection: 1),","        .init(name: \"금성\", assetName: \"Venus\", summary: \"두꺼운 대기를 가진 암석 행성\", depth: -18, orbitRadius: 112, orbitDuration: 18, rotationDuration: 4, rotationDirection: -1),","        .init(name: \"지구\", assetName: \"Earth\", summary: \"액체 상태의 바다가 있는 행성\", depth: 24, orbitRadius: 156, orbitDuration: 24, rotationDuration: 3.5, rotationDirection: 1),","        .init(name: \"화성\", assetName: \"Mars\", summary: \"산화철 때문에 붉게 보이는 행성\", depth: 62, orbitRadius: 204, orbitDuration: 32, rotationDuration: 4.2, rotationDirection: 1)","    ]","}","","struct SolarSystemView: View {","    @State private var selectedPlanet: Planet?","","    var body: some View {","        TimelineView(.animation) { timeline in","            let now = timeline.date.timeIntervalSinceReferenceDate","","            \/\/ 여러 3D 자식을 같은 공간 좌표계에서 정렬합니다.","            SpatialContainer(alignment: .center) {","                HStackLayout(spacing: 24).depthAlignment(.center) {","                    ForEach(Planet.starter) { planet in","                        SelectablePlanetView(","                            planet: planet,","                            time: now,","                            isSelected: selectedPlanet?.id == planet.id","                        ) {","                            withAnimation(.easeInOut(duration: 0.2)) {","                                selectedPlanet = selectedPlanet?.id == planet.id ? nil : planet","                            }","                        }","                    }","                }","                .padding3D(48)","            }","        }","    }","}","","private struct SelectablePlanetView: View {","    let planet: Planet","    let time: TimeInterval","    let isSelected: Bool","    let select: () -> Void","","    private var orbitAngle: Angle {","        .degrees(time.truncatingRemainder(dividingBy: planet.orbitDuration) \/ planet.orbitDuration * 360)","    }","","    private var spinAngle: Angle {","        .degrees(time.truncatingRemainder(dividingBy: planet.rotationDuration) \/ planet.rotationDuration * 360 * planet.rotationDirection)","    }","","    var body: some View {","        PlanetModelView(assetName: planet.assetName)","            .frame(width: isSelected ? 102 : 84, height: isSelected ? 102 : 84)","            .offset(z: planet.depth)","            .offset(x: planet.orbitRadius)","            .rotation3DLayout(orbitAngle, axis: .y)","            .rotation3DLayout(spinAngle, axis: .y)","            .hoverEffect()","            .onTapGesture(perform: select)","            \/\/ 카드의 좌표는 화면 전체가 아니라 선택한 모델의 3D 경계입니다.","            .spatialOverlay(alignment: .bottomFront) {","                if isSelected {","                    PlanetInfoCard(planet: planet, dismiss: select)","                        .offset(z: 12)","                }","            }","    }","}","","private struct PlanetInfoCard: View {","    let planet: Planet","    let dismiss: () -> Void","","    var body: some View {","        VStack(alignment: .leading, spacing: 8) {","            HStack {","                Text(planet.name)","                    .font(.headline)","                Spacer()","                Button(action: dismiss) {","                    Image(systemName: \"xmark\")","                }","                .buttonStyle(.plain)","            }","            Text(planet.summary)","                .font(.caption)","                .foregroundStyle(.secondary)","        }","        .frame(width: 190, alignment: .leading)","        .padding()","        .glassBackgroundEffect()","    }","}","","private struct PlanetModelView: View {","    let assetName: String","","    var body: some View {","        Model3D(named: assetName, bundle: realityKitContentBundle) { phase in","            if let model = phase.model {","                model.resizable().aspectRatio(contentMode: .fit)","            } else if phase.error != nil {","                ContentUnavailableView(\"모델을 불러올 수 없습니다\", systemImage: \"exclamationmark.triangle\")","            } else {","                ProgressView()","            }","        }","    }","}"],"type":"file","syntax":"swift","fileType":"swift","fileName":"PlanetInfoCard.swift","highlights":[]},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/02-PlanetRotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/solarsystematlas\/02-planetrotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0","type":"section","abstract":[{"text":"앞에서 만든 깊이 있는 태양계에 자전과 공전을 더합니다. 핵심은 회전을 단순한 시각 효과로 끝내지 않고, 회전한 모델의 3D 프레임까지 레이아웃에 반영하는 것입니다.","type":"text"}],"title":"움직임을 데이터로 설명하기"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/01-SpatialLayoutBasics#%EA%B9%8A%EC%9D%B4%EB%A5%BC-%EB%A0%88%EC%9D%B4%EC%95%84%EC%9B%83%EC%9D%98-%EC%9D%BC%EB%B6%80%EB%A1%9C-%EB%A7%8C%EB%93%A4%EA%B8%B0":{"abstract":[{"text":"태양계는 행성의 순서만 나열해도 이해할 수 있지만, 모두가 같은 평면에 있으면 궤도와 거리의 감각이 사라집니다. 이 튜토리얼에서는 앱의 구조를 먼저 확인하고, SwiftUI 레이아웃에 깊이 축을 추가하는 방법을 배웁니다.","type":"text"}],"role":"pseudoSymbol","type":"section","url":"\/tutorials\/solarsystematlas\/01-spatiallayoutbasics#%EA%B9%8A%EC%9D%B4%EB%A5%BC-%EB%A0%88%EC%9D%B4%EC%95%84%EC%9B%83%EC%9D%98-%EC%9D%BC%EB%B6%80%EB%A1%9C-%EB%A7%8C%EB%93%A4%EA%B8%B0","kind":"section","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/01-SpatialLayoutBasics#%EA%B9%8A%EC%9D%B4%EB%A5%BC-%EB%A0%88%EC%9D%B4%EC%95%84%EC%9B%83%EC%9D%98-%EC%9D%BC%EB%B6%80%EB%A1%9C-%EB%A7%8C%EB%93%A4%EA%B8%B0","title":"깊이를 레이아웃의 일부로 만들기"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/02-PlanetRotation#%EB%8B%A4%EC%9D%8C-%EB%8B%A8%EA%B3%84":{"role":"pseudoSymbol","kind":"section","url":"\/tutorials\/solarsystematlas\/02-planetrotation#%EB%8B%A4%EC%9D%8C-%EB%8B%A8%EA%B3%84","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation#%EB%8B%A4%EC%9D%8C-%EB%8B%A8%EA%B3%84","type":"section","title":"다음 단계","abstract":[{"type":"text","text":"앞에서 만든 깊이 있는 태양계에 자전과 공전을 더합니다. 핵심은 회전을 단순한 시각 효과로 끝내지 않고, 회전한 모델의 3D 프레임까지 레이아웃에 반영하는 것입니다."}]},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/03-PlanetInfoOverlay#3D-%EA%B2%BD%EA%B3%84-%EC%95%88%EC%97%90-%EC%B9%B4%EB%93%9C%EB%A5%BC-%EC%A0%95%EB%A0%AC%ED%95%98%EA%B8%B0":{"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#3D-%EA%B2%BD%EA%B3%84-%EC%95%88%EC%97%90-%EC%B9%B4%EB%93%9C%EB%A5%BC-%EC%A0%95%EB%A0%AC%ED%95%98%EA%B8%B0","url":"\/tutorials\/solarsystematlas\/03-planetinfooverlay#3D-%EA%B2%BD%EA%B3%84-%EC%95%88%EC%97%90-%EC