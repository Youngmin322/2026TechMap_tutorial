er(alignment: .center) {","                PlanetModelView(assetName: \"Sun\")","","                ForEach(Planet.starter) { planet in","                    PlanetOrbitView(","                        planet: planet,","                        time: now,","                        isSelected: selectedPlanet?.id == planet.id,","                        select: {","                            selectedPlanet = selectedPlanet?.id == planet.id","                                ? nil","                                : planet","                        }","                    )","                }","            }","            .frame(width: 800, height: 380)","            .frame(depth: 620)","            .padding3D(24)","        }","    }","}"],"fileType":"swift","fileName":"SolarSystemView.swift","identifier":"03-selection-state.swift","highlights":[{"line":4},{"line":5},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"type":"file","syntax":"swift"},"doc://co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation/tutorials/SolarSystemAtlas/02-PlanetRotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0":{"abstract":[{"text":"앞에서 만든 ","type":"text"},{"code":"Planet","type":"codeVoice"},{"text":"과 z축 이동량을 이어받아 자전과 공전을 더합니다. 모델의 자전은 ","type":"text"},{"code":"rotation3DLayout","type":"codeVoice"},{"text":"으로, 공전 위치는 시간에 따른 좌표로 표현하고, 태양과 여덟 행성을 같은 중심에 배치합니다.","type":"text"}],"kind":"section","role":"pseudoSymbol","title":"움직임을 데이터로 설명하기","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0","url":"\/tutorials\/solarsystematlas\/02-planetrotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0","type":"section"},"doc://co.kr.youngmin.