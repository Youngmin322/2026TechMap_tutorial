y-step.documentation\/tutorials\/SolarSystemAtlas\/04-RealityKitIntegration#%EC%97%94%ED%8B%B0%ED%8B%B0%EC%9D%98-%EC%9D%B4%EB%A6%84%EA%B3%BC-%ED%81%AC%EA%B8%B0-%ED%86%B5%EC%9D%BC%ED%95%98%EA%B8%B0"},"02-timeline-angle.swift":{"syntax":"swift","highlights":[{"line":7},{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20}],"type":"file","fileType":"swift","fileName":"PlanetOrbitView.swift","content":["import SwiftUI","","struct PlanetOrbitView: View {","    let planet: Planet","    let time: TimeInterval","","    private var orbitAngle: Angle {","        let progress = time.truncatingRemainder(","            dividingBy: planet.orbitDuration","        ) \/ planet.orbitDuration","        return .degrees(progress * 360)","    }","","    private var spinAngle: Angle {","        let progress = time.truncatingRemainder(","            dividingBy: planet.rotationDuration","        ) \/ planet.rotationDuration","        return .degrees(progress * 360 * planet.rotationDirection)","    }","","    var body: some View {","        PlanetModelView(assetName: planet.assetName)","    }","}"],"identifier":"02-timeline-angle.swift"},"doc://co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation/tutorials/SolarSystemAtlas/RealityKit----------":{"kind":"article","abstract":[],"url":"\/tutorials\/solarsystematlas\/realitykit----------","role":"article","type":"topic","title":"RealityKit 장면으로 확장하기","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/RealityKit----------"},"02-planet-tuned.swift":{"syntax":"swift","highlights":[{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"type":"file","fileType":"swift","fileName":"Planet.swift","content":["import Foundation","","struct Planet: Identifiable, Hashable {","    let name: String","    let assetName: String","    let depth: CGFloat","    let orbitRadius: CGFloat","    let orbitDuration: TimeInterval","    let rotationDuration: TimeInterval","    let rotationDirection: Double","","    var id: String { assetName }","","    static let starter: [Planet] = [","        .init(name: \"수성\", assetName: \"Mercury\", depth: -70, orbitRadius: 56, orbitDuration: 8, rotationDuration: 2.4, rotationDirection: 1),","        .init(name: \"금성\", assetName: \"Venus\", depth: -50, orbitRadius: 84, orbitDuration: 12, rotationDuration: 3.8, rotationDirection: -1),","        .init(name: \"지구\", assetName: \"Earth\", depth: -30, orbitRadius: 112, orbitDuration: 16, rotationDuration: 2.8, rotationDirection: 1),","        .init(name: \"화성\", assetName: \"Mars\", depth: -10, orbitRadius: 140, orbitDuration: 20, rotationDuration: 3, rotationDirection: 1),","        .init(name: \"목성\", assetName: \"Jupiter\", depth: 10, orbitRadius: 172, orbitDuration: 25, rotationDuration: 2.2, rotationDirection: 1),","        .init(name: \"토성\", assetName: \"Saturn\", depth: 30, orbitRadius: 204, orbitDuration: 30, rotationDuration: 2.5, rotationDirection: 1),","        .init(name: \"천왕성\", assetName: \"Uranus\", depth: 50, orbitRadius: 236, orbitDuration: 36, rotationDuration: 3.2, rotationDirection: -1),","        .init(name: \"해왕성\", assetName: \"Neptune\", depth: 70, orbitRadius: 268, orbitDuration: 42, rotationDuration: 3.1, rotationDirection: 1)","    ]","}"],"identifier":"02-planet-tuned.swift"},"doc://co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation/tutorials/SolarSystemAtlas/04-RealityKitIntegration#%EC%9E%A5%EB%A9%B4-%EC%83%9D%EC%84%B1%EA%B3%BC-%ED%94%84%EB%A0%88%EC%9E%84-%EA%B0%B1%EC%8B%A0-%EB%82%98%EB%88%84%EA%B8%B0":{"kind":"section","abstract":[{"text":"앞의 세 튜토리얼에서 만든 데이터와 선택 흐름을 실제 SolarSystemAtlas 앱의 ","type":"text"},{"type":"codeVoice","code":"RealityView"},{"text":" 구조로 옮깁니다. 서로 다른 USDZ의 크기를 맞추고, 시간에 따라 엔티티를 갱신하며, 행성 레이블과 공간 탭 입력을 연결합니다.","type":"text"}],"url":"\/tutorials\/solarsystematlas\/04-realitykitintegrat