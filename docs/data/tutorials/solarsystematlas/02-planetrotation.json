on\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#3D-%EA%B2%BD%EA%B3%84-%EC%95%88%EC%97%90-%EC%B9%B4%EB%93%9C%EB%A5%BC-%EC%A0%95%EB%A0%AC%ED%95%98%EA%B8%B0"},{"kind":"task","reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#%EC%99%84%EC%84%B1-%ED%9D%90%EB%A6%84-%EB%90%98%EC%A7%9A%EA%B8%B0"}],"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay"}]},{"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/RealityKit----------","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/04-RealityKitIntegration#%EC%97%94%ED%8B%B0%ED%8B%B0%EC%9D%98-%EC%9D%B4%EB%A6%84%EA%B3%BC-%ED%81%AC%EA%B8%B0-%ED%86%B5%EC%9D%BC%ED%95%98%EA%B8%B0"},{"kind":"task","reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/04-RealityKitIntegration#%ED%83%9C%EC%96%91%EB%B6%80%ED%84%B0-%EC%83%88-%EC%9E%A5%EB%A9%B4%EC%97%90-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0"},{"kind":"task","reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/04-RealityKitIntegration#%EC%9E%A5%EB%A9%B4-%EC%83%9D%EC%84%B1%EA%B3%BC-%ED%94%84%EB%A0%88%EC%9E%84-%EA%B0%B1%EC%8B%A0-%EB%82%98%EB%88%84%EA%B8%B0"},{"kind":"task","reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/04-RealityKitIntegration#%EA%B3%B5%EA%B0%84-%ED%83%AD%EA%B3%BC-SwiftUI-%EC%A0%95%EB%B3%B4-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0"},{"kind":"task","reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/04-RealityKitIntegration#%EC%99%84%EC%84%B1-%EC%9E%A5%EB%A9%B4-%EA%B2%80%EC%A6%9D%ED%95%98%EA%B8%B0"}],"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/04-RealityKitIntegration"}]}]},"sections":[{"chapter":"태양계 움직이기","kind":"hero","backgroundImage":"spatial-layout-rotation.svg","image":"spatial-layout-rotation.svg","title":"정적인 배치에 시간 축 더하기","estimatedTimeInMinutes":25,"content":[{"type":"paragraph","inlineContent":[{"text":"앞에서 만든 ","type":"text"},{"code":"Planet","type":"codeVoice"},{"text":"과 z축 이동량을 이어받아 자전과 공전을 더합니다. 모델의 자전은 ","type":"text"},{"code":"rotation3DLayout","type":"codeVoice"},{"text":"으로, 공전 위치는 시간에 따른 좌표로 표현하고, 태양과 여덟 행성을 같은 중심에 배치합니다.","type":"text"}]}]},{"kind":"tasks","tasks":[{"anchor":"움직임을-데이터로-설명하기","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"애니메이션 값을 뷰에 흩어 놓으면 행성을 추가할 때마다 조건문이 늘어납니다. 대신 "},{"type":"codeVoice","code":"Planet"},{"type":"text","text":" 모델에 "},{"type":"codeVoice","code":"orbitRadius"},{"type":"text","text":", "},{"type":"codeVoice","code":"orbitDuration"},{"type":"text","text":", "},{"type":"codeVoice","code":"rotationDuration"},{"type":"text","text":", "},{"type":"codeVoice","code":"rotationDirection"},{"type":"text","text":"을 둡니다. 뷰는 현재 시각과 이 값만 받아 각도를 계산하므로, 새 행성은 데이터 한 줄로 늘릴 수 있습니다."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TimelineView(.animation)"},{"type":"text","text":"은 화면이 표시되는 동안 현재 시각을 제공합니다. 상태에 매 프레임 누적값을 저장하는 대신, 기준 시각에서 지난 시간을 이용해 각도를 계산하면 뷰가 다시 만들어져도 움직임이 안정적입니다."}]}],"media":"animation-data-flow.svg","mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Views"},{"type":"text","text":" 그룹에 "},{"type":"codeVoice","code":"PlanetOrbitView.swift"},{"type":"text","text":"를 만들고 "},{"type":"strong","inlineContent":[{"type":"text","text":"Add to targets > SolarSystemAtlas"}]},{"type":"text","text":"를 선택합니다. 행성과 시간을 받는 작은 뷰부터 준비합니다. 다음 단계에서도 "},{"type":"codeVoice","code":"time"},{"type":"text","text":"을 받는 이 인터페이스를 유지합니다."}]}],"media":null,"code":"02-timeline-start.swift","runtimePreview":null,"caption":[],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Planet"},{"type":"text","text":"에 공전 반지름, 공전 주기, 자전 주기, 자전 방향을 정의합니다. 실제 천문 비율을 그대로 쓰기보다는, 학습용 화면에서 차이를 느낄 수 있는 보기 좋은 값으로 시작합니다. "},{"type":"codeVoice","code":"depth"},{"type":"text","text":"는 앞 장에서 사용한 z축 이동량으로 유지합니다."}]}],"media":null,"code":"02-planet-motion.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"이 값들을 모델에 넣으면 뷰는 특정 행성의 이름을 알 필요가 없습니다. 데이터와 표현을 분리하는 이 구조가, 여러 행성을 같은 방식으로 움직이는 첫 번째 열쇠입니다."}]}],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PlanetOrbitView"},{"type":"text","text":"가 받은 "},{"type":"codeVoice","code":"time"},{"type":"text","text":"을 각 주기로 나누고, 나머지를 0에서 360도 사이의 각도로 바꿉니다. "},{"type":"codeVoice","code":"orbitAngle"},{"type":"text","text":"과 "},{"type":"codeVoice","code":"spinAngle"},{"type":"text","text":"은 저장하거나 외부에서 따로 전달하지 않고, 같은 시간과 행성 데이터로 계산합니다."}]}],"media":null,"code":"02-timeline-angle.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"아직 이 뷰를 화면에 연결하지 않았으므로 움직임은 보이지 않습니다. 뒤에서 "},{"type":"codeVoice","code":"SolarSystemView"},{"type":"text","text":"의 "},{"type":"codeVoice","code":"TimelineView"},{"type":"text","text":"가 "},{"type":"codeVoice","code":"timeline.date.timeIntervalSinceReferenceDate"},{"type":"text","text":"를 전달하도록 연결합니다. 공전·자전 주기는 0보다 커야 합니다."}]}],"type":"step"}],"title":"움직임을 데이터로 설명하기"},{"anchor":"rotation3DLayout으로-회전의-자리를-계산하기","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"앞 장의 "},{"type":"codeVoice","code":"offset"},{"type":"text","text":"은 표시 위치를 바꾸지만 부모가 계산하는 뷰의 크기는 늘리지 않습니다. "},{"type":"codeVoice","code":"rotation3DEffect"},{"type":"text","text":"도 회전 후의 경계를 레이아웃에 반영하지 않습니다. 반면 "},{"type":"codeVoice","code":"rotation3DLayout"},{"type":"text","text":"은 회전한 모델을 감싸는 경계 상자를 레이아웃 계산에 포함합니다. 이것이 모든 겹침이나 볼륨 밖 잘림을 자동으로 막는다는 뜻은 아닙니다."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"모델의 Y축 자전에는 "},{"type":"codeVoice","code":"rotation3DLayout(spinAngle, axis: .y)"},{"type":"text","text":"를 적용합니다. 공전은 "},{"type":"codeVoice","code":"cos"},{"type":"text","text":"와 "},{"type":"codeVoice","code":"sin"},{"type":"text","text":"으로 위치를 구해 "},{"type":"codeVoice","code":"offset"},{"type":"text","text":"으로 옮깁니다. 자전과 위치 이동을 분리하면 다음 장에서 카드는 행성을 따라가면서도 모델처럼 자전하지 않게 만들 수 있습니다."}]}],"media":"spatial-layout-rotation.svg","mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"앞 장의 "},{"type":"codeVoice","code":"PlanetModelView"},{"type":"text","text":"에 공통 프레임을 더하고, 표시 크기를 "},{"type":"codeVoice","code":"frame(width:height:)"},{"type":"text","text":"로 제한합니다. RealityKitContent의 에셋을 불러오지 못할 때에는 "},{"type":"codeVoice","code":"ProgressView"},{"type":"text","text":" 또는 텍스트를 보여 주어 원인을 쉽게 찾을 수 있게 합니다."}]}],"media":null,"code":"02-model-sized.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"모델 크기를 먼저 통제해야 회전 후 프레임의 변화도 예측할 수 있습니다. 크기가 제각각인 USDZ 에셋을 그대로 배치하면 "},{"type":"codeVoice","code":"rotation3DLayout"},{"type":"text","text":"의 효과를 비교하기 어렵습니다."}]}],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PlanetOrbitView"},{"type":"text","text":"에 자전과 공전 위치를 적용합니다. "},{"type":"codeVoice","code":"cos(orbitAngle)"},{"type":"text","text":"은 좌우 위치를, "},{"type":"codeVoice","code":"sin(orbitAngle)"},{"type":"text","text":"은 깊이 변화를 만듭니다. 깊이 변화에 "},{"type":"codeVoice","code":"0.6"},{"type":"text","text":"을 곱하고 높이에 "},{"type":"codeVoice","code":"-0.3"},{"type":"text","text":"을 곱해, 제한된 볼륨에서도 경로를 읽기 쉽게 펼칩니다. 이 계수들은 실제 천문 궤도를 나타내지 않습니다."}]}],"media":null,"code":"02-orbit-rotation.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"최종 z축 이동량은 앞 장의 "},{"type":"codeVoice","code":"planet.depth"},{"type":"text","text":"에 시간에 따른 공전 깊이를 더한 값입니다. 따라서 행성은 움직여도 "},{"type":"codeVoice","code":"depth"},{"type":"text","text":"가 담당하는 앞뒤 배치의 차이는 유지됩니다."}]}],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SolarSystemView.swift"},{"type":"text","text":"를 갱신해 "},{"type":"codeVoice","code":"TimelineView(.animation)"},{"type":"text","text":"에서 현재 시간을 얻고, 각 "},{"type":"codeVoice","code":"PlanetOrbitView"},{"type":"text","text":"에 같은 "},{"type":"codeVoice","code":"now"},{"type":"text","text":"를 전달합니다. 태양 모델도 그대로 유지합니다."}]}],"media":null,"code":"02-scene-timeline.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"한 줄로 나열했던 "},{"type":"codeVoice","code":"HStackLayout"},{"type":"text","text":" 대신 "},{"type":"codeVoice","code":"SpatialContainer(alignment: .center)"},{"type":"text","text":"로 모델의 중심을 같은 3D 공간에 맞춥니다. 각 행성이 이 공통 중심에서 계산한 위치로 이동하게 됩니다. "},{"type":"codeVoice","code":"SpatialContainer"},{"type":"text","text":"를 이용한 보조 UI 정렬은 다음 장에서 더 살펴봅니다."}]}],"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"시뮬레이터 또는 기기에서 실행해 보며 "},{"type":"codeVoice","code":"orbitDuration"},{"type":"text","text":"과 "},{"type":"codeVoice","code":"rotationDuration"},{"type":"text","text":"을 조절합니다. 공전이 너무 빠르면 깊이 변화를 읽기 어렵고, 너무 느리면 인터랙션을 시험하기 힘듭니다."}]}],"media":null,"code":"02-planet-tuned.swift","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"여기서는 정확한 천문 시뮬레이션보다, "},{"type":"codeVoice","code":"rotation3DLayout"},{"type":"text","text":"이 회전한 뷰의 공간을 존중한다는 점을 관찰하는 것이 목표입니다."}]}],"type":"step"}],"title":"rotation3DLayout으로 회전의 자리를 계산하기"},{"anchor":"다음-단계","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"같은 시간에서 계산한 공전과 자전이 화면에 연결되었는지 확인합니다."}]}],"mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"태양과 여덟 행성이 모두 보이고, 서로 다른 주기로 위치와 방향이 바뀌는지 확인합니다. "},{"type":"codeVoice","code":"depth"},{"type":"text","text":"를 바꾸면 공전 경로가 앞뒤로 이동하는지도 관찰합니다."}]}],"media":null,"code":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"다음 장에서는 이 "},{"type":"codeVoice","code":"SolarSystemView"},{"type":"text","text":"의 시간 전달과 "},{"type":"codeVoice","code":"PlanetOrbitView"},{"type":"text","text":"의 움직임을 유지한 채, 행성 설명 데이터와 선택·카드를 추가합니다."}]}],"type":"step"}],"title":"다음 단계"}]},{"abstract":[{"type":"text","text":"앞 장에서 움직이던 태양계에 행성 설명과 선택 기능을 추가합니다. "},{"type":"codeVoice","code":"TimelineView"},{"type":"text","text":"와 "},{"type":"codeVoice","code":"PlanetOrbitView"},{"type":"text","text":"를 이어서 사용하고, 선택한 행성의 3D 경계에 정보 카드를 배치합니다."}],"featuredEyebrow":"Tutorial","title":"선택한 행성 가까이에 정보를 띄우기","kind":"callToAction","action":{"type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay"}}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"02-planet-motion.swift":{"fileName":"Planet.swift","fileType":"swift","identifier":"02-planet-motion.swift","syntax":"swift","highlights":[{"line":7},{"line":8},{"line":9},{"line":10},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"content":["import Foundation","","struct Planet: Identifiable, Hashable {","    let name: String","    let assetName: String","    let depth: CGFloat","    let orbitRadius: CGFloat","    let orbitDuration: TimeInterval","    let rotationDuration: TimeInterval","    let rotationDirection: Double","","    var id: String { assetName }","","    static let starter: [Planet] = [","        .init(name: \"수성\", assetName: \"Mercury\", depth: -70, orbitRadius: 56, orbitDuration: 10, rotat