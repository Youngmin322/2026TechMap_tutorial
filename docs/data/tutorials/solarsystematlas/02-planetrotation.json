larSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation#%EB%8B%A4%EC%9D%8C-%EB%8B%A8%EA%B3%84","kind":"task"}]}]},{"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/--------------","projects":[{"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay","sections":[{"kind":"task","reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#%EC%84%A0%ED%83%9D-%EC%83%81%ED%83%9C%EB%A5%BC-%ED%95%98%EB%82%98%EB%A1%9C-%EB%AA%A8%EC%9C%BC%EA%B8%B0"},{"kind":"task","reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#3D-%EA%B2%BD%EA%B3%84-%EC%95%88%EC%97%90-%EC%B9%B4%EB%93%9C%EB%A5%BC-%EC%A0%95%EB%A0%AC%ED%95%98%EA%B8%B0"},{"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#%EC%99%84%EC%84%B1-%ED%9D%90%EB%A6%84-%EB%90%98%EC%A7%9A%EA%B8%B0","kind":"task"}]}]}],"reference":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas"},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"category":"SolarSystemAtlas","categoryPathComponent":"SolarSystemAtlas","role":"project","title":"정적인 배치에 시간 축 더하기"},"references":{"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/--------":{"abstract":[],"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/--------","url":"\/tutorials\/solarsystematlas\/--------","kind":"article","type":"topic","title":"태양계 움직이기","role":"article"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/01-SpatialLayoutBasics#%EA%B9%8A%EC%9D%B4%EB%A5%BC-%EB%A0%88%EC%9D%B4%EC%95%84%EC%9B%83%EC%9D%98-%EC%9D%BC%EB%B6%80%EB%A1%9C-%EB%A7%8C%EB%93%A4%EA%B8%B0":{"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/01-SpatialLayoutBasics#%EA%B9%8A%EC%9D%B4%EB%A5%BC-%EB%A0%88%EC%9D%B4%EC%95%84%EC%9B%83%EC%9D%98-%EC%9D%BC%EB%B6%80%EB%A1%9C-%EB%A7%8C%EB%93%A4%EA%B8%B0","url":"\/tutorials\/solarsystematlas\/01-spatiallayoutbasics#%EA%B9%8A%EC%9D%B4%EB%A5%BC-%EB%A0%88%EC%9D%B4%EC%95%84%EC%9B%83%EC%9D%98-%EC%9D%BC%EB%B6%80%EB%A1%9C-%EB%A7%8C%EB%93%A4%EA%B8%B0","role":"pseudoSymbol","kind":"section","abstract":[{"text":"태양계는 행성의 순서만 나열해도 이해할 수 있지만, 모두가 같은 평면에 있으면 궤도와 거리의 감각이 사라집니다. 이 튜토리얼에서는 앱의 구조를 먼저 확인하고, SwiftUI 레이아웃에 깊이 축을 추가하는 방법을 배웁니다.","type":"text"}],"title":"깊이를 레이아웃의 일부로 만들기","type":"section"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/03-PlanetInfoOverlay#%EC%99%84%EC%84%B1-%ED%9D%90%EB%A6%84-%EB%90%98%EC%A7%9A%EA%B8%B0":{"abstract":[{"text":"공간 인터페이스에서는 설명 카드를 화면 구석에 고정하는 것보다, 사용자가 고른 대상과 함께 보이게 하는 편이 맥락을 유지하기 쉽습니다. 이 튜토리얼에서는 탭으로 행성을 선택하고, 그 행성의 3D 경계 안에 정보 카드를 배치합니다.","type":"text"}],"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#%EC%99%84%EC%84%B1-%ED%9D%90%EB%A6%84-%EB%90%98%EC%A7%9A%EA%B8%B0","url":"\/tutorials\/solarsystematlas\/03-planetinfooverlay#%EC%99%84%EC%84%B1-%ED%9D%90%EB%A6%84-%EB%90%98%EC%A7%9A%EA%B8%B0","kind":"section","type":"section","title":"완성 흐름 되짚기","role":"pseudoSymbol"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/02-PlanetRotation":{"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation","url":"\/tutorials\/solarsystematlas\/02-planetrotation","role":"project","kind":"project","estimatedTime":"25min","abstract":[{"text":"앞에서 만든 깊이 있는 태양계에 자전과 공전을 더합니다. 핵심은 회전을 단순한 시각 효과로 끝내지 않고, 회전한 모델의 3D 프레임까지 레이아웃에 반영하는 것입니다.","type":"text"}],"title":"정적인 배치에 시간 축 더하기","type":"topic"},"s2-core-feature.swift":{"highlights":[],"identifier":"s2-core-feature.swift","syntax":"swift","type":"file","content":["import SwiftUI","import RealityKit","import RealityKitContent","","struct Planet: Identifiable, Hashable {","    let name: String","    let assetName: String","    let depth: CGFloat","    let orbitRadius: CGFloat","    let orbitDuration: TimeInterval","    let rotationDuration: TimeInterval","    let rotationDirection: Double","","    var id: String { assetName }","","    static let starter: [Planet] = [","        .init(name: \"수성\", assetName: \"Mercury\", depth: -56, orbitRadius: 72, orbitDuration: 12, rotationDuration: 3, rotationDirection: 1),","        .init(name: \"금성\", assetName: \"Venus\", depth: -18, orbitRadius: 112, orbitDuration: 18, rotationDuration: 4, rotationDirection: -1),","        .init(name: \"지구\", assetName: \"Earth\", depth: 24, orbitRadius: 156, orbitDuration: 24, rotationDuration: 3.5, rotationDirection: 1),","        .init(name: \"화성\", assetName: \"Mars\", depth: 62, orbitRadius: 204, orbitDuration: 32, rotationDuration: 4.2, rotationDirection: 1)","    ]","}","","struct SolarSystemView: View {","    var body: some View {","        TimelineView(.animation) { timeline in","            let now = timeline.date.timeIntervalSinceReferenceDate","","            \/\/ Layout 자체에 깊이 기준면을 제공합니다.","            HStackLayout(spacing: 24).depthAlignment(.center) {","                ForEach(Planet.starter) { planet in","                    PlanetOrbitView(planet: planet, time: now)","                }","            }","            .padding3D(48)","        }","    }","}","","private struct PlanetOrbitView: View {","    let planet: Planet","    let time: TimeInterval","","    private var orbitAngle: Angle {","        .degrees(time.truncatingRemainder(dividingBy: planet.orbitDuration) \/ planet.orbitDuration * 360)","    }","","    private var spinAngle: Angle {","        .degrees(time.truncatingRemainder(dividingBy: planet.rotationDuration) \/ planet.rotationDuration * 360 * planet.rotationDirection)","    }","","    var body: some View {","        PlanetModelView(assetName: planet.assetName)","            .frame(width: 84, height: 84)","            \/\/ 기준면에서의 앞뒤 거리입니다.","            .offset(z: planet.depth)","            \/\/ 반지름만큼 이동한 뷰를 돌려 공전 경로를 만듭니다.","            .offset(x: planet.orbitRadius)","            .rotation3DLayout(orbitAngle, axis: .y)","            \/\/ 행성 자체는 별도의 각도로 자전합니다.","            .rotation3DLayout(spinAngle, axis: .y)","    }","}","","private struct PlanetModelView: View {","    let assetName: String","","    var body: some View {","        Model3D(named: assetName, bundle: realityKitContentBundle) { phase in","            if let model = phase.model {","                model","                    .resizable()","                    .aspectRatio(contentMode: .fit)","            } else if phase.error != nil {","                ContentUnavailableView(\"모델을 불러올 수 없습니다\", systemImage: \"exclamationmark.triangle\")","            } else {","                ProgressView()","            }","        }","    }","}"],"fileName":"SolarSystemView.swift","fileType":"swift"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/01-SpatialLayoutBasics":{"url":"\/tutorials\/solarsystematlas\/01-spatiallayoutbasics","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/01-SpatialLayoutBasics","role":"project","kind":"project","estimatedTime":"20min","abstract":[{"text":"태양계는 행성의 순서만 나열해도 이해할 수 있지만, 모두가 같은 평면에 있으면 궤도와 거리의 감각이 사라집니다. 이 튜토리얼에서는 앱의 구조를 먼저 확인하고, SwiftUI 레이아웃에 깊이 축을 추가하는 방법을 배웁니다.","type":"text"}],"title":"깊이 축을 가진 태양계의 첫 장면","type":"topic"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/02-PlanetRotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0":{"identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0","url":"\/tutorials\/solarsystematlas\/02-planetrotation#%EC%9B%80%EC%A7%81%EC%9E%84%EC%9D%84-%EB%8D%B0%EC%9D%B4%ED%84%B0%EB%A1%9C-%EC%84%A4%EB%AA%85%ED%95%98%EA%B8%B0","role":"pseudoSymbol","kind":"section","abstract":[{"type":"text","text":"앞에서 만든 깊이 있는 태양계에 자전과 공전을 더합니다. 핵심은 회전을 단순한 시각 효과로 끝내지 않고, 회전한 모델의 3D 프레임까지 레이아웃에 반영하는 것입니다."}],"title":"움직임을 데이터로 설명하기","type":"section"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/02-PlanetRotation#rotation3DLayout%EC%9C%BC%EB%A1%9C-%ED%9A%8C%EC%A0%84%EC%9D%98-%EC%9E%90%EB%A6%AC%EB%A5%BC-%EA%B3%84%EC%82%B0%ED%95%98%EA%B8%B0":{"abstract":[{"type":"text","text":"앞에서 만든 깊이 있는 태양계에 자전과 공전을 더합니다. 핵심은 회전을 단순한 시각 효과로 끝내지 않고, 회전한 모델의 3D 프레임까지 레이아웃에 반영하는 것입니다."}],"kind":"section","url":"\/tutorials\/solarsystematlas\/02-planetrotation#rotation3DLayout%EC%9C%BC%EB%A1%9C-%ED%9A%8C%EC%A0%84%EC%9D%98-%EC%9E%90%EB%A6%AC%EB%A5%BC-%EA%B3%84%EC%82%B0%ED%95%98%EA%B8%B0","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/02-PlanetRotation#rotation3DLayout%EC%9C%BC%EB%A1%9C-%ED%9A%8C%EC%A0%84%EC%9D%98-%EC%9E%90%EB%A6%AC%EB%A5%BC-%EA%B3%84%EC%82%B0%ED%95%98%EA%B8%B0","type":"section","title":"rotation3DLayout으로 회전의 자리를 계산하기","role":"pseudoSymbol"},"doc://co.kr.youngmin.SolarSystemAtlas.documentation/tutorials/SolarSystemAtlas/01-SpatialLayoutBasics#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%9D%98-%EC%A7%80%EB%8F%84%EB%A5%BC-%EC%9D%BD%EA%B8%B0":{"role":"pseudoSymbol","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.documentation\/tutorials\/SolarSystemAtlas\/01-SpatialLayoutBasics#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%9D%98-%EC%A7%80%EB%8F%84%EB%A5%BC-%EC%9D%BD%EA%B8%B0","title":"프로젝트의 지도를 읽기","type":"section","kind":"section","url":"\/tutorials\/solarsystematlas\/01-spatiallayoutbasics#%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%9D%98-%EC%A7%80%EB%8F%84%EB%A5%BC-%EC%9D%BD%EA%B8%B0","abstract":[{"type":"text","text":"태양계는 행성의 순서만 나열해도 이해할 수 있지만,