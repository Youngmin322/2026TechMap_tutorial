 인터페이스에서는 설명 카드를 화면 구석에 고정하는 것보다, 사용자가 고른 대상과 함께 보이게 하는 편이 맥락을 유지하기 쉽습니다. 이 튜토리얼에서는 탭으로 행성을 선택하고, 그 행성의 3D 경계 안에 정보 카드를 배치합니다.","type":"text"}],"url":"\/tutorials\/solarsystematlas\/03-planetinfooverlay#%EC%99%84%EC%84%B1-%ED%9D%90%EB%A6%84-%EB%90%98%EC%A7%9A%EA%B8%B0","role":"pseudoSymbol","type":"section","title":"완성 흐름 되짚기","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/03-PlanetInfoOverlay#%EC%99%84%EC%84%B1-%ED%9D%90%EB%A6%84-%EB%90%98%EC%A7%9A%EA%B8%B0"},"02-orbit-rotation.swift":{"syntax":"swift","highlights":[{"line":12},{"line":13},{"line":14}],"type":"file","fileType":"swift","fileName":"PlanetOrbitView.swift","content":["import SwiftUI","","struct PlanetOrbitView: View {","    let planet: Planet","    let orbitAngle: Angle","    let spinAngle: Angle","","    var body: some View {","        PlanetModelView(assetName: planet.assetName)","            .frame(width: 84, height: 84)","            .offset(z: planet.depth)","            .offset(x: planet.orbitRadius)","            .rotation3DLayout(orbitAngle, axis: .y)","            .rotation3DLayout(spinAngle, axis: .y)","    }","}"],"identifier":"02-orbit-rotation.swift"},"02-planet-motion.swift":{"syntax":"swift","highlights":[{"line":7},{"line":8},{"line":9},{"line":10},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22}],"type":"file","fileType":"swift","fileName":"Planet.swift","content":["import Foundation","","struct Planet: Identifiable, Hashable {","    let name: String","    let assetName: String","    let depth: CGFloat","    let orbitRadius: CGFloat","    let orbitDuration: TimeInterval","    let rotationDuration: TimeInterval","    let rotationDirection: Double","","    var id: String { assetName }","","    static let starter: [Planet] = [","        .init(name: \"수성\", assetName: \"Mercury\", depth: -70, orbitRadius: 56, orbitDuration: 10, rotationDuration: 2.8, rotationDirection: 1),","        .init(name: \"금성\", assetName: \"Venus\", depth: -50, orbitRadius: 84, orbitDuration: 14, rotationDuration: 4.2, rotationDirection: -1),","        .init(name: \"지구\", assetName: \"Earth\", depth: -30, orbitRadius: 112, orbitDuration: 18, rotationDuration: 3, rotationDirection: 1),","        .init(name: \"화성\", assetName: \"Mars\", depth: -10, orbitRadius: 140, orbitDuration: 22, rotationDuration: 3.2, rotationDirection: 1),","        .init(name: \"목성\", assetName: \"Jupiter\", depth: 10, orbitRadius: 172, orbitDuration: 28, rotationDuration: 2.4, rotationDirection: 1),","        .init(name: \"토성\", assetName: \"Saturn\", depth: 30, orbitRadius: 204, orbitDuration: 34, rotationDuration: 2.7, rotationDirection: 1),","        .init(name: \"천왕성\", assetName: \"Uranus\", depth: 50, orbitRadius: 236, orbitDuration: 40, rotationDuration: 3.6, rotationDirection: -1),","        .init(name: \"해왕성\", assetName: \"Neptune\", depth: 70, orbitRadius: 268, orbitDuration: 46, rotationDuration: 3.4, rotationDirection: 1)","    ]","}"],"identifier":"02-planet-motion.swift"},"doc://co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation/tutorials/SolarSystemAtlas/01-SpatialLayoutBasics#Xcode-%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EC%83%9D%EC%84%B1":{"kind":"section","abstract":[{"text":"Xcode에서 새 visionOS 프로젝트를 만드는 것부터 시작합니다. RealityKitContent 에셋과 Swift 파일을 차례로 준비한 뒤, 태양과 여덟 행성을 불러와 깊이 축에 배치합니다.","type":"text"}],"url":"\/tutorials\/solarsystematlas\/01-spatiallayoutbasics#Xcode-%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EC%83%9D%EC%84%B1","role":"pseudoSymbol","type":"section","title":"Xcode 프로젝트 생성","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/01-SpatialLayoutBasics#Xcode-%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EC%83%9D%EC%84%B1"},"spatial-layout-rotation.svg":{"type":"image","variants":[{"traits":["1x","light"],"svgID":"title","url":"\/images\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/spatial-layout-ro