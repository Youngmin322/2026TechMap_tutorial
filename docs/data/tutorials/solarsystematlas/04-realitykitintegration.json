":"project"},"04-position-tilted.swift":{"fileName":"OrbitPosition.swift","identifier":"04-position-tilted.swift","highlights":[{"line":8},{"line":9},{"line":10},{"line":11},{"line":13},{"line":14}],"fileType":"swift","content":["import RealityKit","","func planetPosition(","    radius: Float,","    diameter: Float,","    angle: Float",") -> SIMD3<Float> {","    let tabletopTilt: Float = .pi \/ 10","    let depth = sin(angle) * radius","","    return SIMD3(","        cos(angle) * radius,","        diameter \/ 2 - depth * sin(tabletopTilt),","        depth * cos(tabletopTilt)","    )","}"],"type":"file","syntax":"swift"},"doc://co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation/documentation/SolarSystemAtlas/RealityKit-Scene-Guide":{"title":"RealityKit 장면 구현 가이드","role":"article","type":"topic","url":"\/documentation\/solarsystematlas\/realitykit-scene-guide","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/documentation\/SolarSystemAtlas\/RealityKit-Scene-Guide","abstract":[{"text":"SolarSystemAtlas가 서로 다른 크기의 USDZ를 정규화하고 공전 궤도와 입력 가능한 행성 장면을 만드는 방식을 살펴봅니다.","type":"text"}],"kind":"article"},"04-scene-update.swift":{"fileName":"SolarSystemScene.swift","identifier":"04-scene-update.swift","highlights":[{"line":5},{"line":6},{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":14},{"line":15},{"line":16},{"line":17},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35}],"fileType":"swift","content":["import SwiftUI","import RealityKit","","struct SolarSystemScene: View {","    @State private var animationStartDate = Date()","","    var body: some View {","        TimelineView(.animation) { timeline in","            let elapsedTime = max(","                0,","                timeline.date.timeIntervalSince(animationStartDate)","            )","","            RealityView { content in","                let root = Entity()","                root.name = \"solar-system-root\"","                content.add(root)","","                await addSun(to: root)","","                for planet in Planet.starter {","                    await addPlanet(planet, to: root)","                }","            } update: { content in","                guard let root = content.entities.first(where: {","                    $0.name == \"solar-system-root\"","                }) else {","                    return","                }","","                updateSun(in: root, elapsedTime: elapsedTime)","","                for planet in Planet.starter {","                    update(planet, in: root, elapsedTime: elapsedTime)","                }","            }","        }","    }","}"],"type":"file","syntax":"swift"},"doc://co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation/tutorials/SolarSystemAtlas/RealityKit----------":{"title":"RealityKit 장면으로 확장하기","kind":"article","role":"article","url":"\/tutorials\/solarsystematlas\/realitykit----------","type":"topic","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/tutorials\/SolarSystemAtlas\/RealityKit----------","abstract":[]}}}