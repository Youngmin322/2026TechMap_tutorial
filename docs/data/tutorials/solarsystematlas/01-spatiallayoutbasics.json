:5}],"syntax":"swift","content":["import SwiftUI","","struct SolarSystemView: View {","    var body: some View {","        HStackLayout(spacing: 12).depthAlignment(.center) {","            PlanetModelView(assetName: \"Sun\")","                .frame(width: 96, height: 96)","","            ForEach(Planet.starter) { planet in","                PlanetModelView(assetName: planet.assetName)","                    .frame(width: 68, height: 68)","            }","        }","        .padding3D(32)","    }","}"],"type":"file","fileType":"swift","fileName":"SolarSystemView.swift","identifier":"01-layout-aligned.swift"},"01-planet-depth.swift":{"highlights":[{"line":6},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18}],"syntax":"swift","content":["import Foundation","","struct Planet: Identifiable, Hashable {","    let name: String","    let assetName: String","    let depth: CGFloat","","    var id: String { assetName }","","    static let starter: [Planet] = [","        .init(name: \"수성\", assetName: \"Mercury\", depth: -70),","        .init(name: \"금성\", assetName: \"Venus\", depth: -50),","        .init(name: \"지구\", assetName: \"Earth\", depth: -30),","        .init(name: \"화성\", assetName: \"Mars\", depth: -10),","        .init(name: \"목성\", assetName: \"Jupiter\", depth: 10),","        .init(name: \"토성\", assetName: \"Saturn\", depth: 30),","        .init(name: \"천왕성\", assetName: \"Uranus\", depth: 50),","        .init(name: \"해왕성\", assetName: \"Neptune\", depth: 70)","    ]","}"],"type":"file","fileType":"swift","fileName":"Planet.swift","identifier":"01-planet-depth.swift"},"spatial-layout-depth.svg":{"variants":[{"traits":["1x","light"],"svgID":"title","url":"\/images\/co.kr.youngmin.SolarSystemAtlas.step-by-step.documentation\/spatial-layout-depth.svg"}],"type":"image","identifier":"spatial-layout-depth.svg","alt":"동일한 가로 레이아웃에서 행성이 서로 다른 깊이에 놓인 개념도"}}}