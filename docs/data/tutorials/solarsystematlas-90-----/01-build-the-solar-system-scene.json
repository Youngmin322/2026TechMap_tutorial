 let rotationDuration: Double","    let rotationDirection: Double","    ","    \/\/ SwiftUI의 ForEach가 각 행성을 안정적으로 구분할 때 사용하는 고유 값","    \/\/ assetName은 RealityKit asset 이름이면서 행성마다 중복되지 않으므로 id로 사용","    var id: String { assetName }","    ","    static let starter: [Planet] = [","        Planet(","            name: \"수성\",","            assetName: \"Mercury\",","            summary: \"태양에 가장 가까운 행성\",","            displaySize: 42,","            orbitRadius: 92,","            orbitDuration: 8,","            rotationDuration: 2.8,","            rotationDirection: 1","        ),","        Planet(","            name: \"금성\",","            assetName: \"Venus\",","            summary: \"두꺼운 대기를 가진 암석 행성\",","            displaySize: 48,","            orbitRadius: 130,","            orbitDuration: 12,","            rotationDuration: 4.2,","            rotationDirection: -1","        ),","        Planet(","            name: \"지구\",","            assetName: \"Earth\",","            summary: \"액체 상태의 바다가 있는 행성\",","            displaySize: 50,","            orbitRadius: 168,","            orbitDuration: 16,","            rotationDuration: 3,","            rotationDirection: 1","        ),","        Planet(","            name: \"화성\",","            assetName: \"Mars\",","            summary: \"산화철 때문에 붉게 보이는 행성\",","            displaySize: 46,","            orbitRadius: 206,","            orbitDuration: 22,","            rotationDuration: 3.2,","            rotationDirection: 1","        ),","        Planet(","            name: \"목성\",","            assetName: \"Jupiter\",","            summary: \"태양계에서 가장 큰 가스 행성\",","            displaySize: 74,","            orbitRadius: 252,","            orbitDuration: 32,","            rotationDuration: 2.2,","            rotationDirection: 1","        ),","        Planet(","            name: \"토성\",","            assetName: \"Saturn\",","            summary: \"뚜렷한 고리로 알려진 가스 행성\",","            displaySize: 72,","            orbitRadius: 296,","            orbitDuration: 42,","            rotationDuration: 2.5,","            rotationDirection: 1","        ),","        Planet(","            name: \"천왕성\",","            assetName: \"Uranus\",","            summary: \"자전축이 크게 기울어진 얼음 행성\",","            displaySize: 58,","            orbitRadius: 336,","            orbitDuration: 54,","            rotationDuration: 3.8,","            rotationDirection: -1","        ),","        Planet(","            name: \"해왕성\",","            assetName: \"Neptune\",","            summary: \"빠른 바람이 부는 얼음 행성\",","            displaySize: 58,","            orbitRadius: 374,","            orbitDuration: 66,","            rotationDuration: 4,","            rotationDirection: 1","        )","    ]","}"],"type":"file","fileName":"Planet.swift","fileType":"swift","syntax":"swift","identifier":"Checkpoint-Planet.swift","highlights":[]},"03-Add-Sun.swift":{"content":["private let sunDiameter: Float = 0.088","","private func addSun(to root: Entity) async {","    guard let sun = try? await fittedModel(","        named: \"Sun\",","        targetDiameter: sunDiameter","    ) else {","        return","    }","","    sun.name = \"sun-model\"","    sun.position.y = sunDiameter \/ 2","    root.addChild(sun)","}"],"type":"file","fileName":"SolarSystemAtlasView.swift — 태양","fileType":"","syntax":"","identifier":"03-Add-Sun.swift","highlights":[]},"doc://co.kr.youngmin.SolarSystemAtlas.ninety-minute.documentation/tutorials/SolarSystemAtlas-90-----/01-Build-the-Solar-System-Scene#0-5%EB%B6%84-%EC%8B%9C%EC%9E%91-%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%99%80-%EC%97%90%EC%85%8B-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"type":"section","kind":"section","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.ninety-minute.documentation\/tutorials\/SolarSystemAtlas-90-----\/01-Build-the-Solar-System-Scene#0-5%EB%B6%84-%EC%8B%9C%EC%9E%91-%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8%EC%99%80-%EC%97%90%EC%85%8B-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","role":