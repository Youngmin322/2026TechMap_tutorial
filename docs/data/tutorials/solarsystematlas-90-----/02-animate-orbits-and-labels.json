se {","        return","    }","","    let radius = Float(planet.orbitRadius) * pointToMeter","    let diameter = Float(planet.displaySize) * pointToMeter","    model.position = planetPosition(","        radius: radius,","        diameter: diameter,","        angle: Float(orbitAngle)","    )","    model.orientation = rotation(radians: Float(spinAngle))","}"],"highlights":[{"line":1},{"line":2},{"line":3},{"line":7},{"line":9},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34}]},"doc://co.kr.youngmin.SolarSystemAtlas.ninety-minute.documentation/tutorials/SolarSystemAtlas-90-----/02-Animate-Orbits-and-Labels#22-30%EB%B6%84-%ED%96%89%EC%84%B1-%EC%9D%B4%EB%A6%84%EC%9D%B4-%EB%AA%A8%EB%8D%B8%EC%9D%84-%EB%94%B0%EB%9D%BC%EA%B0%80%EA%B2%8C-%EB%A7%8C%EB%93%A4%EA%B8%B0":{"type":"section","kind":"section","identifier":"doc:\/\/co.kr.youngmin.SolarSystemAtlas.ninety-minute.documentation\/tutorials\/SolarSystemAtlas-90-----\/02-Animate-Orbits-and-Labels#22-30%EB%B6%84-%ED%96%89%EC%84%B1-%EC%9D%B4%EB%A6%84%EC%9D%B4-%EB%AA%A8%EB%8D%B8%EC%9D%84-%EB%94%B0%EB%9D%BC%EA%B0%80%EA%B2%8C-%EB%A7%8C%EB%93%A4%EA%B8%B0","role":"pseudoSymbol","abstract":[{"text":"세션 1의 정적인 장면에 궤도 메시를 추가하고, 절대 시간을 공전 위치와 자전 각도로 변환하고, 행성 이름이 모델을 따라가도록 만듭니다.","type":"text"}],"url":"\/tutorials\/solarsystematlas-90-----\/02-animate-orbits-and-labels#22-30%EB%B6%84-%ED%96%89%EC%84%B1-%EC%9D%B4%EB%A6%84%EC%9D%B4-%EB%AA%A8%EB%8D%B8%EC%9D%84-%EB%94%B0%EB%9D%BC%EA%B0%80%EA%B2%8C-%EB%A7%8C%EB%93%A4%EA%B8%B0","title":"22–30분: 행성 이름이 모델을 따라가게 만들기"},"doc://co.kr.youngmin.SolarSystemAtlas.ninety-minute.documentation/tutorials/SolarSystemAtlas-90-----/03-Add-Selection-and-Info-Card#0-12%EB%B6%84-RealityKit-%EC%97%94%ED%8B%B0%ED%8B%B0%EC%97%90-%EA%B3%B5%EA%B0%84-%EC%9E%85%EB%A0%A5-%EC%97%B0%EA%B2%B0%ED%95%