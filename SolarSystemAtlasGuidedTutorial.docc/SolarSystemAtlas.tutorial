@Tutorials(name: "SolarSystemAtlas") {
    @Intro(title: "직접 만들며 배우는 visionOS 태양계 도감") {
        준비된 행성 에셋을 사용해 빈 visionOS 화면에서 시작하고, 데이터 모델과 RealityKit 장면, 애니메이션, 공간 입력, 정보 카드까지 한 단계씩 직접 구현합니다.

        각 단계는 **입력할 코드**, **코드의 역할**, **이 방식이 필요한 이유**, **실행 후 확인할 결과**를 함께 설명합니다. 앞 단계를 완료해야 다음 단계의 코드가 자연스럽게 이어집니다.

        @Image(source: "spatial-layout-cover.svg", alt: "태양과 여러 행성이 궤도 위에 배치된 SolarSystemAtlas 완성 장면 개념도")
    }

    @Chapter(name: "프로젝트의 뼈대 만들기") {
        볼륨 윈도우를 준비하고, 화면과 3D 에셋 사이에서 기준이 되는 행성 데이터를 만듭니다. 먼저 모든 모델을 단순 목록으로 표시해 에셋 연결을 검증합니다.

        @Image(source: "realityview-architecture.svg", alt: "Planet 데이터와 RealityKitContent가 화면으로 연결되는 프로젝트 구조도")

        @TutorialReference(tutorial: "doc:01-PrepareVisionOSProject")
        @TutorialReference(tutorial: "doc:02-CreatePlanetCatalog")
    }

    @Chapter(name: "움직이는 태양계 장면 만들기") {
        SwiftUI 목록을 RealityView 엔티티 장면으로 바꾸고, 서로 다른 USDZ 크기를 통일합니다. 궤도 메시와 시간 기반 공전·자전을 차례로 추가합니다.

        @Image(source: "animation-data-flow.svg", alt: "시간과 행성 데이터가 위치와 회전으로 변환되는 애니메이션 흐름도")

        @TutorialReference(tutorial: "doc:03-BuildRealityViewScene")
        @TutorialReference(tutorial: "doc:04-AddOrbitsAndAnimation")
    }

    @Chapter(name: "사용자와 상호작용하는 도감 완성하기") {
        행성 이름을 3D 장면에 붙이고, 공간 탭으로 행성을 선택합니다. 마지막으로 선택한 행성의 설명 카드와 접근성 처리를 추가합니다.

        @Image(source: "interaction-flow.svg", alt: "행성 탭이 선택 상태와 정보 카드로 이어지는 상호작용 흐름도")

        @TutorialReference(tutorial: "doc:05-AddLabelsAndSelection")
        @TutorialReference(tutorial: "doc:06-CompletePlanetInfoCard")
    }
}
