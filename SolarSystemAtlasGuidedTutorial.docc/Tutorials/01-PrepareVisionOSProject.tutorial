@Tutorial(time: 25) {
    @Intro(title: "볼륨 안에서 시작하는 visionOS 프로젝트") {
        SolarSystemAtlas가 사용할 프로젝트 구조와 볼륨 윈도우를 준비합니다. 이 단계가 끝나면 3D 콘텐츠가 들어갈 공간과 임시 시작 화면이 실행됩니다.

        @Image(source: "spatial-layout-depth.svg", alt: "앞뒤 깊이를 가진 볼륨 공간의 개념도")
    }

    @Section(title: "실습 프로젝트와 에셋 확인하기") {
        @ContentAndMedia {
            이 튜토리얼은 Xcode의 visionOS App 템플릿과 제공된 `RealityKitContent` 패키지에서 시작합니다. SwiftUI 코드는 직접 작성하지만, 태양과 행성의 USDZ는 미리 준비된 파일을 사용합니다.

            코드를 쓰기 전에 에셋과 파일 위치를 확인하면 모델 로딩 실패를 코드 문제로 오해하지 않을 수 있습니다.

            @Image(source: "realityview-architecture.svg", alt: "앱 소스, Planet 데이터, RealityKitContent 에셋의 관계")
        }

        @Steps {
            @Step {
                Xcode에서 `SolarSystemAtlas.xcodeproj`를 엽니다. 직접 새 프로젝트를 만든다면 visionOS의 **App** 템플릿을 선택하고 Interface는 **SwiftUI**, Immersive Space는 **Full**로 설정하세요.

                프로젝트 내비게이터에서 `SolarSystemAtlas/`, `Packages/RealityKitContent/`, `Sources/SolarSystemAtlas/`가 서로 다른 역할을 가진다는 점을 확인합니다. 앱 코드는 첫 번째 폴더에, USDZ는 패키지에, DocC 원본은 Sources에 있습니다.
            }

            @Step {
                `RealityKitContent.rkassets`를 열어 `Sun`, `Mercury`, `Venus`, `Earth`, `Mars`, `Jupiter`, `Saturn`, `Uranus`, `Neptune` 모델이 있는지 확인합니다.

                나중에 코드에서 사용하는 `assetName`은 이 이름과 대소문자까지 같아야 합니다. `Entity(named:in:)`과 `Model3D`는 문자열이 다르면 다른 파일을 추측해서 찾아 주지 않습니다.
            }
        }
    }

    @Section(title: "볼륨 윈도우 구성하기") {
        @ContentAndMedia {
            일반 window는 2D 표면을 제공하지만 `.windowStyle(.volumetric)`은 가로·세로·깊이를 가진 공간을 제공합니다. 태양계의 가장 바깥 궤도가 잘리지 않도록 기본 크기도 미터 단위로 지정합니다.

            `WindowGroup`은 앱의 기본 화면이고 `ImmersiveSpace`는 나중에 더 큰 장면으로 확장할 수 있는 별도 공간입니다. 이번 실습의 핵심 장면은 먼저 WindowGroup 안에 만듭니다.

            @Image(source: "spatial-layout-depth.svg", alt: "볼륨 윈도우 안의 가로 세로 깊이 축")
        }

        @Steps {
            @Step {
                `SolarSystemAtlasApp.swift`를 열고 아래 형태로 정리합니다. `ContentView`에 `appModel`을 environment로 전달하는 이유는 몰입 공간 상태를 여러 화면에서 공유할 수 있게 하기 위해서입니다.

                @Code(name: "SolarSystemAtlasApp.swift", file: "Checkpoint-SolarSystemAtlasApp.swift", reset: true)
            }

            @Step {
                `ContentView.swift`의 body를 임시 시작 화면으로 바꿉니다. 지금은 3D 코드를 넣지 않습니다. 프로젝트 설정과 화면 실행을 먼저 분리해서 확인해야 이후 오류의 원인을 좁히기 쉽습니다.

                @Code(name: "ContentView.swift", file: "01-Content-Start.swift", reset: true)
            }
        }
    }

    @Section(title: "첫 체크포인트 실행하기") {
        @Steps {
            @Step {
                visionOS Simulator를 실행 대상으로 선택하고 Run을 누릅니다. 평면 창이 아니라 깊이를 가진 볼륨 안에 태양 아이콘과 `SolarSystemAtlas` 제목이 보여야 합니다.

                창이 너무 작거나 잘려 보이면 `.defaultSize` 값을 먼저 확인하세요. 이 체크포인트에서 앱이 실행되어야 다음 튜토리얼의 모델 로딩 문제를 프로젝트 설정과 분리해서 판단할 수 있습니다.
            }

            @Step {
                실행을 멈춘 뒤 `SolarSystemAtlas` 그룹 안에 `Models`와 `Views` 폴더가 없다면 새 그룹으로 만듭니다. 다음 단계부터 데이터 타입은 Models에, 화면 코드는 Views에 추가합니다.
            }
        }
    }
}
