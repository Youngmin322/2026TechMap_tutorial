@Tutorial(time: 30) {
    @Intro(title: "세션 2: 궤도선과 공전·자전 애니메이션 만들기") {
        세션 1의 정적인 장면에 궤도 메시를 추가하고, 절대 시간을 공전 위치와 자전 각도로 변환하고, 행성 이름이 모델을 따라가도록 만듭니다.

        @Image(source: "animation-data-flow.svg", alt: "시간이 태양과 행성의 회전 및 궤도 위치로 변환되는 흐름")
    }

    @Section(title: "0–10분: 여덟 개의 궤도선 만들기") {
        @ContentAndMedia {
            RealityKit 기본 도형에는 얇은 원형 띠가 없으므로 안쪽·바깥쪽 정점을 만들고 삼각형 인덱스로 연결합니다. 모든 궤도는 하나의 plate 아래에 넣어 같은 기울기를 공유합니다.

            @Image(source: "spatial-layout-rotation.svg", alt: "평평한 원형 궤도들을 함께 기울여 테이블처럼 보이게 하는 과정")
        }

        @Steps {
            @Step {
                파일 위쪽에 UIKit을 import합니다. 궤도 재질의 반투명 흰색을 만들 때 `UIColor`를 사용합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "04-Import-UIKit.swift")
            }

            @Step {
                구조체 마지막에 `makeOrbitRing`을 추가합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "04-Orbit-Ring.swift")

                각 구간은 안쪽과 바깥쪽 정점 두 개를 만들고 두 삼각형으로 연결됩니다. `UnlitMaterial`은 주변 조명과 관계없이 궤도선을 일정한 밝기로 보여 줍니다.
            }

            @Step {
                `addOrbitPlate`를 추가하고 RealityView 생성 클로저에서 태양보다 먼저 호출합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "04-Add-Orbit-Plate.swift")

                하나의 부모를 기울이면 여덟 궤도에 같은 회전을 반복해서 적용할 필요가 없습니다. 행성 위치 계산에도 같은 `tabletopTilt` 값을 사용해 선과 모델을 맞춥니다.
            }

            @Step {
                앱을 실행해 여덟 개의 반투명 궤도선과 정지한 행성이 같은 경로 위에 놓이는지 확인합니다.
            }
        }
    }

    @Section(title: "10–22분: 시간 기반 공전과 자전 추가하기") {
        @ContentAndMedia {
            프레임마다 각도를 조금씩 더하면 프레임 손실이 속도 차이로 누적됩니다. 시작 시각부터 흐른 시간을 주기로 나눈 진행률을 사용하면 같은 시각에는 항상 같은 위치가 계산됩니다.

            @Image(source: "animation-data-flow.svg", alt: "TimelineView의 경과 시간이 공전 진행률과 자전 진행률로 나뉘는 구조")
        }

        @Steps {
            @Step {
                `animationStartDate` 상태를 추가하고 기존 RealityView를 `TimelineView(.animation)` 안으로 옮깁니다. 생성 클로저 뒤에는 update 클로저를 추가합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "04-Timeline.swift")

                생성 클로저는 엔티티를 한 번 만들고 update 클로저는 이미 있는 엔티티의 값만 바꿉니다. 매 프레임 모델을 다시 로딩하면 안 됩니다.
            }

            @Step {
                반복 진행률과 y축 회전을 만드는 두 함수를 구조체 마지막에 추가합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "04-Cycle-Progress.swift")

                나머지를 주기로 나누면 진행률이 0에서 1 사이를 반복합니다. 한 바퀴는 `2π` 라디안입니다.
            }

            @Step {
                태양의 자전을 갱신하는 `updateSun`을 추가합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "04-Update-Sun.swift")

                태양 엔티티의 이름으로 기존 모델을 찾아 방향만 바꿉니다.
            }

            @Step {
                행성 하나의 공전 위치와 자전 방향을 계산하는 `update`를 추가합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "04-Update-Planet.swift")

                `orbitDuration`은 위치 변화 속도를, `rotationDuration`과 `rotationDirection`은 자전 속도와 방향을 결정합니다. 그래서 금성과 천왕성은 다른 행성과 반대 방향으로 회전할 수 있습니다.
            }

            @Step {
                RealityView update 클로저에서 루트를 찾은 뒤 태양과 모든 행성의 update 함수를 호출합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "04-Update-All.swift")
            }
        }
    }

    @Section(title: "22–30분: 행성 이름이 모델을 따라가게 만들기") {
        @ContentAndMedia {
            attachment는 SwiftUI 뷰를 RealityKit 엔티티로 사용할 수 있게 합니다. 텍스트는 SwiftUI로 스타일링하고 위치는 행성과 같은 수학으로 갱신합니다.

            @Image(source: "spatial-layout-overlay.svg", alt: "공전하는 행성 위에 SwiftUI 이름 레이블이 붙어 있는 장면")
        }

        @Steps {
            @Step {
                RealityView 생성 클로저가 `attachments`를 받고, attachments 클로저에서 여덟 행성의 이름을 만듭니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "05-Attachments.swift")

                이 코드는 attachment 문법을 보여 주는 축약 예시입니다. 현재 파일의 RealityView에 같은 `attachments:` 부분을 합치고 별도의 `PlanetLabelScene`은 만들지 않습니다.
            }

            @Step {
                `addPlanet`에 `RealityViewAttachments` 매개변수를 추가하고, 모델을 루트에 넣은 다음 해당 행성의 레이블 엔티티도 연결합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "05-Connect-Label.swift")

                레이블의 y 좌표는 행성 반지름과 0.018m 여백만큼 위로 올립니다.
            }

            @Step {
                행성 update 함수 마지막에서 같은 각도로 레이블 위치도 갱신합니다.

                @Code(name: "SolarSystemAtlasView.swift", file: "05-Update-Label.swift")
            }

            @Step {
                세션 2 체크포인트에서 지금까지 작성한 파일 전체를 비교합니다. DocC는 세션 1에서 새로 추가된 줄을 강조합니다.

                @Code(name: "SolarSystemAtlasView.swift — 세션 2 체크포인트", file: "90-Session2-Checkpoint.swift", previousFile: "90-Session1-Checkpoint.swift")
            }

            @Step {
                앱을 실행합니다. 궤도선 위에서 행성이 서로 다른 속도로 공전·자전하고 각 이름이 모델 위를 따라가면 세션 2를 완료한 것입니다.
            }
        }
    }
}
